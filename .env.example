# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── Database (LangGraph checkpointer) ────────────────
POSTGRES_URI=postgresql://postgres:postgres@postgres:5432/agentflow
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ── Redis (rate limiting) ───────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Tools ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── Observability ────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=agentflow-production
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=agentflow

# ── Security ─────────────────────────────────────────
AGENTFLOW_API_KEY=your-super-secret-api-key-change-me
JWT_SECRET=your-jwt-secret-change-me
JWT_ALGORITHM=HS256
RATE_LIMIT_DEFAULT=60/minute

# ── App ──────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_REVISIONS=3
AGENT_TIMEOUT_SECONDS=120
NODE_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3
