# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── Database ─────────────────────────────────────────
POSTGRES_URI=postgresql://postgres:postgres@postgres:5432/agentflow
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Tools ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── Observability ────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=agentflow-production
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=agentflow

# ── Security ─────────────────────────────────────────
AGENTFLOW_API_KEY=change-me-to-32-char-random-string
JWT_SECRET=change-me-to-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RUN=10/minute

# ── Limits ───────────────────────────────────────────
MAX_REQUEST_BYTES=1048576
MAX_REVISIONS=3
AGENT_TIMEOUT_SECONDS=120
NODE_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3

# ── App ──────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
